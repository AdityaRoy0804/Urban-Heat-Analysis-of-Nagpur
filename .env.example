# Copy this file to .env and fill in real values. Never commit the real .env.

# Google Earth Engine
GEE_PROJECT_ID=nagpur-uhi-472913

# Copernicus Data Space Ecosystem (https://dataspace.copernicus.eu) - always
# free, no billing account. Register an OAuth client under your account.
CDSE_CLIENT_ID=your-cdse-client-id
CDSE_CLIENT_SECRET=your-cdse-client-secret

# Optional - only used if you pass --stac-provider planetary_computer to
# scripts/01_acquire_data.py. Free to obtain; anonymous access also works for
# light use without this. https://planetarycomputer.microsoft.com/docs/concepts/sas/
PC_SDK_SUBSCRIPTION_KEY=
